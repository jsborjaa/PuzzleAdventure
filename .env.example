# Client (Vite). Required for the live catalog and rankings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Defaults to Google sample (test) AdMob ids. Production units also need android strings.xml.
# VITE_ADMOB_APP_ID=ca-app-pub-xxxxxxxx~yyyyyyyyyy
# VITE_ADMOB_REWARDED_UNIT_ID=ca-app-pub-xxxxxxxx/zzzzzzzzzz

# Ingest CLI only. Never put this in the game bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
